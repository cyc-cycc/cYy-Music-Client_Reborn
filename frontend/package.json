{
  "name": "cYy_music_client-Reborn",
  "version": "8.4.0",
  "description": "cYy Music Client - Reborn - HTML 前端 + FastAPI 后端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir",
    "dist:mac": "electron-builder --mac",
    "dist:mac:dmg": "electron-builder --mac dmg",
    "dist:mac:zip": "electron-builder --mac zip"
  },
  "keywords": [],
  "author": "cYy",
  "license": "GPL-3.0",
  "type": "commonjs",
  "build": {
    "appId": "com.cyy.musicclient",
    "productName": "cYy Music Client - Reborn",
    "asar": true,
    "files": [
      "main.js",
      "index.html",
      "renderer.js",
      "effects.js",
      "style.css",
      "enhanced.css",
      "mini.html",
      "mini-renderer.js",
      "desktop-lyric.html",
      "desktop-lyric-renderer.js",
      "package.json",
      "js/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/cyy_backend",
        "to": "backend"
      },
      {
        "from": "../ffmpeg.exe",
        "to": "backend/ffmpeg.exe"
      }
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "icon": "../gui/icon_256.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "../dist/cyy_backend",
          "to": "backend"
        },
        {
          "from": "../ffmpeg.exe",
          "to": "backend/ffmpeg.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "cYy-Music-Client-Reborn-${version}-portable.exe"
    },
    "directories": {
      "output": "../dist-app"
    },
    "mac": {
      "icon": "../gui/icon.icns",
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "../dist/cyy_backend",
          "to": "backend"
        },
        {
          "from": "../ffmpeg",
          "to": "backend/ffmpeg"
        }
      ]
    },
    "dmg": {
      "title": "cYy Music Client - Reborn ${version}",
      "artifactName": "cYy-Music-Client-Reborn-${version}-${arch}.dmg"
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@electron/remote": "^2.0.1"
  }
}
